# Copy to .env and fill in. .env is git-ignored: it holds your tokens.

# ── Required ──────────────────────────────────────────────────────────────────

# GitHub token used for listing PRs and posting review comments (as you).
# Get it with: gh auth token
GH_TOKEN=

# Long-lived Claude Code token so `claude -p` can run inside the container.
# Get it with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# ── Which repositories (set SCAN_DIR, REPOS, or both) ────────────────────────

# Absolute path of the folder that contains your checkouts. Mounted read-only.
# Defaults to ~/Documents.
REPOS_ROOT=/Users/me/code

# A folder of checkouts, relative to REPOS_ROOT. Every subfolder with a .git is offered
# as a local repo, and its `origin` remote adds its GitHub repo to the PR list.
# A repo cloned there later shows up by itself.
SCAN_DIR=my-org

# Extra GitHub repositories with no checkout under SCAN_DIR, as owner/name, comma-separated.
# REPOS=my-org/infra

# Extra local checkouts outside SCAN_DIR, as label=path relative to REPOS_ROOT.
# LOCAL_REPOS=tools=side-projects/tools

# ── Optional ──────────────────────────────────────────────────────────────────

# Port the app is published on: http://localhost:<HOST_PORT>. Defaults to 37703.
# HOST_PORT=37703

# Port of the Express server in dev mode (npm run dev). Defaults to 3100.
# PORT=3100
