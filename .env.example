# ./start.sh creates .env and writes the Claude token for you. Copy this file only to set the
# optional values below. .env is git-ignored: it holds your token.

# Long-lived Claude Code token so `claude -p` can run inside the container.
# ./start.sh runs `claude setup-token` and saves it here the first time.
CLAUDE_CODE_OAUTH_TOKEN=

# GH_TOKEN is not needed any more: ./start.sh takes it from gh at each start. When set,
# `docker compose up` without ./start.sh uses it.
# GH_TOKEN=

# ── Which repositories ────────────────────────────────────────────────────────
# The PR list shows the repositories picked in the app (Repositories, in the left rail).
# Until you pick, it starts from SCAN_DIR and REPOS below.

# Absolute path of the folder that contains your checkouts. Mounted read-only.
# Defaults to ~/Documents.
REPOS_ROOT=/Users/me/code

# A folder of checkouts, relative to REPOS_ROOT. Every subfolder with a .git is offered
# as a local repo, and its `origin` remote joins the starting pick of the PR list.
# A repo cloned there later shows up by itself in Local branches.
SCAN_DIR=my-org

# GitHub repositories with no checkout under SCAN_DIR, added to the starting pick, as owner/name, comma-separated.
# REPOS=my-org/infra

# Extra local checkouts outside SCAN_DIR, as label=path relative to REPOS_ROOT.
# LOCAL_REPOS=tools=side-projects/tools

# ── Optional ──────────────────────────────────────────────────────────────────

# Port the app is published on: http://localhost:<HOST_PORT>. Defaults to 37703.
# HOST_PORT=37703

# Port of the Express server in dev mode (npm run dev). Defaults to 3100.
# PORT=3100
